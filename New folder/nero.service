[Unit]
Description=NERO PLATINUM network monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nero

# Optional env file (create it if you want overrides)
EnvironmentFile=-/etc/nero/nero.env

ExecStart=/usr/bin/python3 /opt/nero/main111.py --interface ${NERO_INTERFACE} --router-ip ${NERO_ROUTER_IP} --lan-prefix ${NERO_LAN_PREFIX} --log-level ${NERO_LOG_LEVEL}

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

